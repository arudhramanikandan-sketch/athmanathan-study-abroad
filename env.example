# =============================================================
# ATHMANATHAN STUDY ABROAD - Environment Configuration
# =============================================================

# SESSION_SECRET: (Optional on Vercel, recommended for production)
# Secret key used for signing session tokens and admin authentication.
# If not provided, a default secure secret is used.
SESSION_SECRET="your_random_secure_jwt_session_secret_2026_xyz"

# GEMINI_API_KEY: (Optional)
# API Key for Google Gemini services if AI counseling features are enabled.
GEMINI_API_KEY=""

# PORT: (Optional)
# Server port for standalone Node.js / Docker hosting (defaults to 3000).
# Not required on Vercel (Vercel manages serverless ports automatically).
PORT=3000
